# Pooled (pgbouncer) connection string — used by the app at runtime.
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require"

# Unpooled (direct) connection string — used by Prisma Migrate to run schema migrations.
# If you use Vercel's Neon integration, this is provided automatically under this same name.
DATABASE_URL_UNPOOLED="postgresql://user:password@host.region.aws.neon.tech/dbname?sslmode=require"

# Secret key used to sign login session cookies (JWT). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET="replace-with-a-random-32-byte-base64-string"
